# TripPilot environment template.
#
# Copy to .env and fill in. `.env` is git-ignored; never commit real values.
# Every variable here is read by app/trippilot/core/config.py and nowhere else.
#
#   cp .env.example .env

# --- Application ------------------------------------------------------------
# One of: local | staging | production
TRIPPILOT_APP_ENV=local

# Must be false when APP_ENV=production; startup fails otherwise.
TRIPPILOT_DEBUG=false

# --- Logging ----------------------------------------------------------------
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL (case-insensitive)
TRIPPILOT_LOG_LEVEL=DEBUG
# json -> one object per line (production, CI); console -> human-readable (local)
TRIPPILOT_LOG_FORMAT=console

# Request/response header used to correlate logs across services.
TRIPPILOT_TRACE_HEADER=X-Trace-Id

# --- Database ---------------------------------------------------------------
# PostgreSQL. Optional today: no code opens a connection yet, and /ready
# reports the database as `not_configured` while this is unset.
# Use the `postgresql+asyncpg://` driver with SQLAlchemy's async engine.
TRIPPILOT_DATABASE_URL=postgresql+asyncpg://trippilot:trippilot@localhost:5432/trippilot

# --- LLM (reserved) ---------------------------------------------------------
# Declared so model configuration has exactly one home when the agent lands.
# No code reads these yet; leaving them unset is correct for the current stage.
# TRIPPILOT_LLM_PROVIDER=anthropic
# TRIPPILOT_LLM_MODEL=
# TRIPPILOT_LLM_API_KEY=
